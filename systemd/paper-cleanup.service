[Unit]
Description=Paper-Trader Cleanup: Equity ausduennen und Speicher pruefen
After=paper-trader.service

[Service]
Type=oneshot
User=paper
Group=paper
WorkingDirectory=/opt/paper-trader
EnvironmentFile=/opt/paper-trader/.env
ExecStart=/opt/paper-trader/.venv/bin/python cleanup.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=paper-cleanup
